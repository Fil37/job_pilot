# Copy to .env (never committed). Leave empty what you do not use.
FT_CLIENT_ID=          # France Travail API (francetravail.io, API "Offres d'emploi v2")
FT_CLIENT_SECRET=
FLASK_SECRET_KEY=      # any long random string (keeps your session across restarts)
LLM_API_KEY=           # later (steps 6-9), provider still to be chosen
IMAP_PASSWORD=         # later (step 8), application password, read-only use
