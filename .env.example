# Copy to .env (never committed). Leave empty what you do not use.
FT_CLIENT_ID=          # France Travail API (francetravail.io, API "Offres d'emploi v2")
FT_CLIENT_SECRET=
FLASK_SECRET_KEY=      # any long random string (keeps your session across restarts)
DEEPSEEK_API_KEY=      # DeepSeek (same key as auto_clip)
IMAP_PASSWORD=         # later (step 8), application password, read-only use
GITHUB_TOKEN=                  # optional: publish on your portfolio (online: PORTFOLIO_TOKEN)
# Online only (Streamlit + GitHub Actions), see README "En ligne sur Streamlit":
# JOB_PILOT_DATABASE_URL=postgresql://...?sslmode=require
# JOB_PILOT_SNAPSHOT_KEY=      # python -m app.agent.common_cloud new-key
# JOB_PILOT_APP_PASSWORD=      # optional password of the Streamlit app
